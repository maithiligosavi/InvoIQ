# =============================================================================
# InvoIQ Backend Environment Variables
# =============================================================================

# --- Database Configuration ---
# Standard full connection string (recommended for Render, Railway, Supabase, Neon, etc.)
# If DATABASE_URL is set, it takes precedence over DB_USER/DB_PASSWORD/etc.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/invoiq

# Discrete parameters (optional alternative if DATABASE_URL is not provided)
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=invoiq

# --- Security & JWT Authentication ---
# REQUIRED in production. Generate a strong secret: openssl rand -hex 32
JWT_SECRET=generate-a-strong-32-byte-hex-secret-for-production

# Environment mode: "production" or "development"
# In "production", missing JWT_SECRET or invalid DB config triggers an immediate error.
ENVIRONMENT=production

# --- CORS & Network ---
# The URL of your deployed frontend (e.g. https://invoiq.vercel.app)
FRONTEND_URL=https://your-frontend-domain.com

# --- API Documentation ---
# Set to "true" to expose /docs and /redoc. Defaults to "false" in production.
ENABLE_DOCS=false

